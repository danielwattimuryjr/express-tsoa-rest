{
    "entryFile": "src/app.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/**/*Controller.ts"
    ],
    "spec": {
        "outputDirectory": "src/build",
        "specVersion": 3,
        "basePath": "/api/v1"
    },
    "routes": {
        "routesDir": "src/build"
    }
}